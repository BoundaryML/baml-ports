// Port of goldmark _tools/gen-emb-structs.go.
//
// Reads a JSON description of struct data and writes Go source embedding it in
// a compact form (this tool generates Go code for the Go package; the BAML
// port of the generated tables is produced by tools/gen instead, because BAML
// has no package-level constants to embed data into).

function emb_structs_usage() -> string {
    "Usage of emb-structs:\n\n  Embed Go structs as compact format in the binary.\n  JSON file format:\n    {\n      \"prefix\": \"html5entities\", // prefix for the generated const/var\n      \"types\": { // struct field types\n          \"Name\": \"string\",         // struct fields\n          \"CodePoints\": \"[]int\",\n          \"Characters\": \"[]byte\"\n      },\n\n      // array of struct data\n      // all data must be a string\n      \"data\": [ \n        {\"Name\": \"AElig\", \"CodePoints\": [\"198\"], \"Characters\": [\"0xc3\", \"0x86\"]},\n        {\"Name\": \"AMP\", \"CodePoints\": [\"38\"], \"Characters\": [\"0x26\"]},\n      ]\n    }\n\n  -b string\n    \tbuild tag(optional)\n  -i string\n    \tsource JSON file path(required)\n  -o string\n    \toutput file path(required)\n"
}

function json_str(v: baml.json.json) -> string {
    match (v) {
        let s: string => s,
        _ => {
            baml.sys.panic("expected a string");
            ""
        }
    }
}

function json_arr(v: baml.json.json) -> baml.json.json[] {
    match (v) {
        let a: baml.json.json[] => a,
        _ => {
            baml.sys.panic("expected an array");
            let none: baml.json.json[] = [];
            none
        }
    }
}

function json_obj(v: baml.json.json) -> map<string, baml.json.json> {
    match (v) {
        let m: map<string, baml.json.json> => m,
        _ => {
            baml.sys.panic("expected an object");
            let none: map<string, baml.json.json> = {};
            none
        }
    }
}

/// Go: `fmt.Sprintf("\\x%02x", n)`.
function hex_escape_byte(n: int) -> string {
    let digits = "0123456789abcdef";
    "\\x" + (digits.at((n / 16) % 16) ?? "0") + (digits.at(n % 16) ?? "0")
}

function emb_structs_sub_command(args: string[]) -> int {
    let flags = parse_string_flags(args, { "i": "", "o": "", "b": "" });
    if (flags == null) {
        return usage(emb_structs_usage(), "flag provided but not defined");
    }
    let input_json_path = flags["i"];
    let output_path = flags["o"];
    let build_tag = flags["b"];
    if (input_json_path.length() == 0 || output_path.length() == 0) {
        return usage(emb_structs_usage(), null);
    }
    let input_json_source = baml.fs.read(input_json_path) catch_all (e) {
        _ => {
            baml.sys.panic("cannot read " + input_json_path);
            ""
        }
    };
    let source = json_obj(baml.json.parse(input_json_source) catch_all (e) {
        _ => {
            baml.sys.panic("invalid JSON in " + input_json_path);
            null
        }
    });

    // Go: filepath.Base(filepath.Dir(filepath.Abs(outputPath)))
    let abs = if (output_path.starts_with("/")) { output_path } else {
        let pwd = baml.sys.exec("pwd", [], null) catch_all (e) { _ => null };
        let dir = if (pwd == null) { "." } else { pwd.stdout.to_string().trim() };
        dir + "/" + output_path
    };
    let parts = abs.split("/");
    let pkg = if (parts.length() >= 2) { parts[parts.length() - 2] } else { "main" };

    let f = root.util.new_buffer();
    let writeln = (s: string) -> void {
        f.write_string(s + "\n");
    };

    if (build_tag.length() > 0) {
        writeln("//go:build " + build_tag);
        writeln("");
    }
    writeln("// Code generated by _tools; DO NOT EDIT.");
    writeln("");
    writeln("package " + pkg);

    let prefix = json_str(source.get("prefix") ?? null);
    let types = json_obj(source.get("types") ?? null);
    let data = json_arr(source.get("data") ?? null);

    writeln("const _" + prefix + "Length = " + data.length().to_string());

    // (Go ranges over a map here, so the property order is random.)
    for (let prop in types.keys()) {
        let typ = json_str(types[prop]);
        if (typ == "string") {
            f.write_string("const _" + prefix + prop + " string = \"");
            for (let d0 in data) {
                f.write_string(json_str(json_obj(d0).get(prop) ?? null));
            }
            writeln("\"");
            f.write_string("const _" + prefix + prop + "Index  = \"");
            for (let d0 in data) {
                f.write_string(hex_escape_byte(json_str(json_obj(d0).get(prop) ?? null).byte_length()));
            }
            writeln("\"");
            continue;
        }

        if (typ.starts_with("[]")) {
            let elm_typ = typ.slice(2, typ.length());
            f.write_string("var _" + prefix + prop + " = [...]" + elm_typ + "{");
            let i = 0;
            for (let d0 in data) {
                let arr = json_arr(json_obj(d0).get(prop) ?? null);
                let j = 0;
                for (let a in arr) {
                    f.write_string(json_str(a));
                    if (i != data.length() - 1 || j != arr.length() - 1) {
                        f.write_string(", ");
                    }
                    j += 1;
                }
                i += 1;
            }
            writeln("}");
            f.write_string("var _" + prefix + prop + "Index  = \"");
            for (let d0 in data) {
                f.write_string(hex_escape_byte(json_arr(json_obj(d0).get(prop) ?? null).length()));
            }
            writeln("\"");
            continue;
        }

        f.write_string("var _" + prefix + prop + " = [...]" + typ + "{");
        let i = 0;
        for (let d0 in data) {
            f.write_string(json_str(json_obj(d0).get(prop) ?? null));
            if (i != data.length() - 1) {
                f.write_string(", ");
            }
            i += 1;
        }
        writeln("}");
    }
    baml.fs.write(output_path, f.string()) catch_all (e) {
        _ => {
            baml.io.println("Failed to open " + output_path);
            return 1;
        }
    };
    0
}
