// Port of goldmark extra_test.go (`!goldmark_v1_attribute` build).

/// Go: `testTimeoutMultiplier`, read from GOLDMARK_TEST_TIMEOUT_MULTIPLIER in `init()`.
function test_timeout_multiplier() -> float {
    let v = baml.env.get("GOLDMARK_TEST_TIMEOUT_MULTIPLIER") catch_all (e) { _ => null };
    if (v == null) {
        return 1.0;
    }
    baml.Float.parse(v) catch_all (e) { _ => 1.0 }
}

function extras_failures() -> string[] {
    let markdown = root.testutil.new_markdown_to_string_func(
        root.parser.new(),
        root.renderer.html.new(opts = [root.renderer.html.with_xhtml(), root.renderer.html.with_unsafe()]),
    );
    let t = root.testutil.new_recording_t();
    root.testutil.do_test_case_file(markdown, "testdata/extra.txt", t, no = root.testutil.parse_cli_case_arg());
    t.errors
}

test "TestExtras" {
    assert.equal(extras_failures(), []);
}

/// Parses and renders `source` (Go: `r.Render(&b, source, p.Parse(source))`).
function render_with(p: root.parser.Parser, r: root.renderer.Renderer, source: string, parse_opts: root.parser.ParseOption[] = []) -> string {
    let b = root.util.new_buffer();
    let src = source.to_utf8();
    r.render(b, src, p.parse(src, parse_opts), []);
    b.string()
}

function ends_with_non_space_characters() -> string {
    let p = root.parser.new();
    let r = root.renderer.html.new(opts = [root.renderer.html.with_xhtml(), root.renderer.html.with_unsafe()]);
    render_with(p, r, "```\na\n```")
}

test "TestEndsWithNonSpaceCharacters" {
    assert.equal(ends_with_non_space_characters(), "<pre><code>a\n</code></pre>\n");
}

function windows_new_line() -> string[] {
    let p = root.parser.new();
    let r = root.renderer.html.new(opts = [root.renderer.html.with_xhtml()]);
    [render_with(p, r, "a  \r\nb\n"), render_with(p, r, "a\\\r\nb\r\n")]
}

test "TestWindowsNewLine" {
    assert.equal(windows_new_line(), ["<p>a<br />\nb</p>\n", "<p>a<br />\nb</p>\n"]);
}

class MyIDGenerator {
    implements root.parser.IDGenerator {
        function generate(self, value: uint8array, kind: root.ast.NodeKind) -> uint8array {
            "my-id".to_utf8()
        }
    }
}

function autogenerated_ids() -> string {
    let p = root.parser.new(options = [root.parser.with_auto_heading_id(), root.parser.with_id_generator(MyIDGenerator {})]);
    let r = root.renderer.html.new();
    render_with(p, r, "# Title1\n## Title2")
}

test "TestAutogeneratedIDs" {
    assert.equal(autogenerated_ids(), "<h1 id=\"my-id\">Title1</h1>\n<h2 id=\"my-id-1\">Title2</h2>\n");
}

/// Shared body of the Go performance tests: returns an error message if
/// rendering `source` takes longer than 5s (times the multiplier).
function performance_failure(source: string, what: string) -> string[] {
    let p = root.parser.new();
    let r = root.renderer.html.new(opts = [root.renderer.html.with_xhtml(), root.renderer.html.with_unsafe()]);
    let started = baml.time.Instant.now();
    render_with(p, r, source);
    let elapsed_ms = started.elapsed().to_milliseconds().to_int() catch_all (e) { _ => 0 };
    let limit_ms = (5000.0 * test_timeout_multiplier()).itrunc() catch_all (e) { _ => 5000 };
    if (elapsed_ms > limit_ms) {
        return [what + " took too long: " + elapsed_ms.to_string() + "ms"];
    }
    let none: string[] = [];
    none
}

test "TestDeepNestedLabelPerformance" {
    let n = 50000;
    assert.equal(performance_failure("[".repeat(n) + "]".repeat(n), "Parsing deep nested labels"), []);
}

test "TestManyProcessingInstructionPerformance" {
    let n = 50000;
    assert.equal(performance_failure("a " + "<?".repeat(n), "Parsing processing instructions"), []);
}

test "TestManyCDATAPerformance" {
    let n = 50000;
    assert.equal(performance_failure("a <![CDATA[".repeat(n), "Parsing processing instructions"), []);
}

test "TestManyDeclPerformance" {
    let n = 50000;
    assert.equal(performance_failure("a <!A ".repeat(n), "Parsing processing instructions"), []);
}

test "TestManyCommentPerformance" {
    let n = 50000;
    assert.equal(performance_failure("a <!-- ".repeat(n), "Parsing processing instructions"), []);
}

function dangerous_url_string_case() -> string {
    let p = root.parser.new();
    let r = root.renderer.html.new();
    render_with(p, r, "[Basic](javascript:alert('Basic'))\n[CaseInsensitive](JaVaScRiPt:alert('CaseInsensitive'))\n")
}

test "TestDangerousURLStringCase" {
    assert.equal(dangerous_url_string_case(), "<p><a href=\"\">Basic</a>\n<a href=\"\">CaseInsensitive</a></p>\n");
}

function atx_heading_attributes_failures() -> string[] {
    let p = root.parser.new(options = [root.parser.with_auto_heading_id(), root.parser.with_attribute()]);
    let source = "# Heading {#my-id .my-class custom=\"hello\"}".to_utf8();
    let n = p.parse(source, []);
    let heading = n.first_child();
    if (heading == null) {
        return ["expected first node to be heading, got nothing"];
    }
    if (heading.kind() != root.ast.kind_heading()) {
        return ["expected first node to be heading, got " + heading.kind()];
    }
    let id_val = heading.attribute("id");
    if (id_val == null) {
        return ["expected to find attribute 'id'"];
    }
    if (id_val.bytes(source).to_string() != "my-id") {
        return ["expected id 'my-id', got " + id_val.bytes(source).to_string()];
    }
    let custom_val = heading.attribute("custom");
    if (custom_val == null) {
        return ["expected to find attribute 'custom'"];
    }
    if (custom_val.bytes(source).to_string() != "hello") {
        return ["expected custom 'hello', got " + custom_val.bytes(source).to_string()];
    }
    let none: string[] = [];
    none
}

test "TestATXHeadingAttributes" {
    assert.equal(atx_heading_attributes_failures(), []);
}

function dangerous_url_with_references() -> string[] {
    let p = root.parser.new(options = [root.parser.with_auto_heading_id(), root.parser.with_attribute()]);
    let r = root.renderer.html.new();
    [
        render_with(p, r, "[click](&#106;avascript:alert(1))"),
        render_with(p, r, "<javascript:alert(document.domain)>"),
        render_with(p, r, "![alt](javascript:alert(document.domain))"),
    ]
}

test "TestDangerousURLWithReferences" {
    assert.equal(dangerous_url_with_references(), [
        "<p><a href=\"\">click</a></p>\n",
        "<p><a href=\"\">javascript:alert(document.domain)</a></p>\n",
        "<p><img src=\"\" alt=\"alt\"></p>\n",
    ]);
}

class TestIDGenerator {
    implements root.parser.IDGenerator {
        function generate(self, value: uint8array, kind: root.ast.NodeKind) -> uint8array {
            "test-id".to_utf8()
        }
    }
}

function parse_context_results() -> string[] {
    let p = root.parser.new(options = [root.parser.with_auto_heading_id(), root.parser.with_attribute()]);
    let r = root.renderer.html.new();
    let source = "# test test";
    let out: string[] = [];
    // If no context is provided, the default ID generator should be used.
    out.push(render_with(p, r, source));
    // If a context is provided but no ID generator is set, the default ID generator should be used.
    let pctx = root.parser.new_context();
    out.push(render_with(p, r, source, parse_opts = [root.parser.with_context(pctx)]));
    // If a context is provided with an ID generator, the provided ID generator should be used.
    let pctx2 = root.parser.new_context(opts = [root.parser.with_id_generator(TestIDGenerator {})]);
    out.push(render_with(p, r, source, parse_opts = [root.parser.with_context(pctx2)]));
    out
}

test "TestParseContext" {
    assert.equal(parse_context_results(), [
        "<h1 id=\"test-test\">test test</h1>\n",
        "<h1 id=\"test-test\">test test</h1>\n",
        "<h1 id=\"test-id\">test test</h1>\n",
    ]);
}
