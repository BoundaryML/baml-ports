// Ported from sasso `src/builtins/colorspace_matrices.rs` `mod tests` (namespace `root.builtins.colorspace.matrices.tests`).

/// Every matrix value parses back to the exact bit pattern extracted
/// from the dart-sass bundle.
test "bit_exactness" {
    assert.equal(
        root.builtins.colorspace.matrices.LINEAR_A98_RGB_TO_LINEAR_DISPLAY_P3().map(
            root.std.f64_to_bits,
        ),
        [
            0x3ff266c96793a52an,
            0xbfc3364b3c9d294dn,
            0x0000000000000000n,
            0x3fa7c4021729fe3dn,
            0x3fee83bfde8d601cn,
            0x0000000000000000n,
            0x3f9875fd59a08407n,
            0x3f9b24116e099baen,
            0x3fee632f89c2af02n,
        ],
    );
    assert.equal(
        root.builtins.colorspace.matrices.LINEAR_A98_RGB_TO_LINEAR_PROPHOTO_RGB().map(
            root.std.f64_to_bits,
        ),
        [
            0x3fe7af0ae62e5c24n,
            0x3fbcffe2dce20a63n,
            0x3fc2c3e2f8d58a3cn,
            0x3fc19b40edb6bc6bn,
            0x3feaa89143d9bf4an,
            0x3f9e13d017123365n,
            0x3f982a00d8df029en,
            0x3fb2e37954de327bn,
            0x3fece240ce9d419cn,
        ],
    );
    assert.equal(
        root.builtins.colorspace.matrices.LINEAR_A98_RGB_TO_LINEAR_REC2020().map(
            root.std.f64_to_bits,
        ),
        [
            0x3fec131e6bb3d285n,
            0x3fb3d6a0a7217eb1n,
            0x3fa720d7f67fda46n,
            0x3fb8bc421666f0f0n,
            0x3fec87644d7e0e88n,
            0x3f8844dbed44d65an,
            0x3f97789e7acb0ef2n,
            0x3fa608e7854c5999n,
            0x3fede3ac93d4e1efn,
        ],
    );
    assert.equal(
        root.builtins.colorspace.matrices.LINEAR_A98_RGB_TO_LINEAR_SRGB().map(root.std.f64_to_bits),
        [
            0x3ff65faa45c7c3c2n,
            0xbfd97ea9171f0f07n,
            0x0000000000000000n,
            0x0000000000000000n,
            0x3ff0000000000000n,
            0x0000000000000000n,
            0x0000000000000000n,
            0xbfa5fac9da23e3b9n,
            0x3ff0afd64ed11f1en,
        ],
    );
    assert.equal(
        root.builtins.colorspace.matrices.LINEAR_A98_RGB_TO_LMS().map(root.std.f64_to_bits),
        [
            0x3fe2722210ed73c9n,
            0x3fd7aca88260a995n,
            0x3fab789ade2376cen,
            0x3fd2f6d95b8fae1en,
            0x3fe2ef02c9448a58n,
            0x3fbcac84479cf4c8n,
            0x3fbf9c4549dfa453n,
            0x3fcc18888982dacfn,
            0x3fe50655346354c2n,
        ],
    );
    assert.equal(
        root.builtins.colorspace.matrices.LINEAR_A98_RGB_TO_XYZ_D50().map(root.std.f64_to_bits),
        [
            0x3fe38346f2da2e86n,
            0x3fca47453e8f2db3n,
            0x3fc319a963004f9fn,
            0x3fd3e97734999357n,
            0x3fe40559eca24b7an,
            0x3fb02f53c88756d5n,
            0x3f93f0198c984d22n,
            0x3faf2b8b2b016aa6n,
            0x3fe7d508455d1ec8n,
