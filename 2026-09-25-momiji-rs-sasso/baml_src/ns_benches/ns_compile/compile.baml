// Ported from sasso `benches/compile.rs` (namespace `root.benches.compile`).
//
// CodSpeed benchmarks for the `sasso` SCSS -> CSS pipeline.
//
// Each benchmark drives the public [`sasso::compile`] entry point, which runs
// the full pipeline (scan -> parse -> evaluate -> emit) over a representative
// input. Inputs range from a large generated stylesheet to focused snippets
// that stress nesting, control flow and the color functions.
//
// **These benchmarks must measure the program that ships.** Two ways of
// getting that wrong were measured on 2026-09-16 and are fixed below; see
// `docs/PERF_PLAN_2026-09-16.md` (B0) for the numbers.
//
// 1. The `ScopedAlloc` bump arena is installed here, exactly as `src/main.rs`
//    and `wasm/src/lib.rs` install it. Without it every recorded number
//    measures sasso against the system malloc: -41% on macOS, -22% on Linux,
//    and it *inverts* the cross-machine ranking rather than shifting it by a
//    constant.
// 2. At least one workload supplies a display URL. `compile` enables
//    diagnostics only when `options.url` is `Some`, so without one the whole
//    deprecation path -- ~16% of a compile, and where the 2026-09-15
//    regression landed -- never executes.
//
// PORT: run it with `RUST_MIN_STACK=1073741824 baml run benches.compile.main`.
// divan is replaced by the minimal wall-clock stand-in at the end of this file
// (`Bencher`, `black_box`, `divan_main`): every `#[divan::bench]` function is
// listed in `BENCHES()`, timed with `root.std.now_nanos()`, and reported in a
// divan-style table (fastest / slowest / median / mean / samples / iters).
// It honours divan's `DIVAN_SAMPLE_COUNT` (default 100) and `DIVAN_MAX_TIME`
// (seconds; unlimited in divan, 10 s per benchmark by default here because a
// BAML compile is much slower than a native one) and, like
// `cargo bench -- <filter>`, runs only the benchmarks whose names contain one
// of the positional arguments given after `--`.

// PORT: `use divan::{black_box, Bencher};` → the stand-ins below;
// `use sasso::{compile, compile_with_source_map, Options, OutputStyle};` →
// `root.compile`, `root.compile_with_source_map`, `root.Options`,
// `root.OutputStyle`.

/// The allocator the CLI and the wasm package ship with (`src/main.rs:40`,
/// `wasm/src/lib.rs:40`). Benchmarking without it measures a different program.
function GLOBAL() -> root.arena.ScopedAlloc {
    // PORT: `#[global_allocator]` has no BAML counterpart (the VM owns all
    // memory); the static is kept as a plain value, as in `main.baml`.
    root.arena.ScopedAlloc {  }
}

function main() -> void {
    corpora_still_compile();
    // PORT: `divan::main()`.
    divan_main();
}

/// ~400-component generated stylesheet (`bench/corpus/generated/large.scss`).
/// Self-contained: only pulls in the built-in `sass:math` module.
function LARGE() -> string {
    include_str("../bench/corpus/generated/large.scss")
}

/// Legacy-deprecation-dense sheet: 1200 `@include`s of one mixin whose 13 call
/// sites are all deprecated names, so the same 13 spans repeat throughout.
/// Generated by `bench/scripts/gen_gate_corpora.py`.
function LEGACY_DEPRECATIONS() -> string {
    include_str("../bench/corpus/gate/legacy_deprecations.scss")
}

/// `@extend`-heavy sheet: placeholder chains, class extends, and `@extend`
/// inside nested and `@media` contexts. Generated by the same script.
function EXTEND_HEAVY() -> string {
    include_str("../bench/corpus/gate/extend_heavy.scss")
}

/// Multi-line comma selector lists: the only shape that puts `eval_style_rule`
/// on its `share_current == false` branch, where the per-complex list is
/// rebuilt instead of shared. Every other corpus here, and `large.scss`, has
/// zero of them, so that branch was unmeasurable before this file existed.
/// Carries a few dropped `> +` selectors too, at the density a real sheet has.
function SELECTOR_LISTS() -> string {
    include_str("../bench/corpus/gate/selector_lists.scss")
}

/// Multi-file `@use` graph: 43 files behind one entry.
function USE_GRAPH_ENTRY() -> string {
    include_str("../bench/corpus/gate/use_graph/entry.scss")
}

/// The same graph, with every module also loaded directly by the entry, so
/// ~40 modules are reached through two paths instead of one. Compiles to
/// byte-identical CSS -- `@use` is idempotent.
function USE_GRAPH_REDUNDANT() -> string {
    include_str("../bench/corpus/gate/use_graph/redundant.scss")
}

/// The `@use` graph is the one corpus that is not just a string: its imports
/// have to resolve on disk, so the benchmark needs real paths. They are baked
/// in at compile time, which is also when the `include_str!`s above read the
/// entries, so the source and the URL cannot disagree about which checkout
/// they came from.
///
/// The URL is what `@use "sections/s1"` resolves against -- dart-sass tries the
/// containing file's directory before any load path -- so it has to be the
/// entry's own path, not a bare name.
function USE_GRAPH_ENTRY_URL() -> string {
    // PORT: `concat!(env!("CARGO_MANIFEST_DIR"), "…")` → `+`.
    CARGO_MANIFEST_DIR() + "/bench/corpus/gate/use_graph/entry.scss"
}

/// As [`USE_GRAPH_ENTRY_URL`], for the redundant-`@use` entry.
function USE_GRAPH_REDUNDANT_URL() -> string {
    CARGO_MANIFEST_DIR() + "/bench/corpus/gate/use_graph/redundant.scss"
}

/// The load path the corpus's vendored `lib` package resolves through, so the
/// benchmark exercises the load-path arm of `FsImporter::canonicalize` -- the
/// arm that records dependencies -- and not only relative resolution.
function USE_GRAPH_VENDOR() -> string {
    CARGO_MANIFEST_DIR() + "/bench/corpus/gate/use_graph/vendor"
}

/// The marker rule `bench/scripts/gen_gate_corpora.py` emits into every gate
/// corpus (`MANIFEST.json` records it as `expectedMarker`).
function GATE_MARKER() -> string {
    ".sasso-gate-corpus"
}

// PORT: the raw strings `r#"…"#` below are spelled with escapes: a BAML
// backtick string is dedented and trimmed, which would change the source.

/// Deeply nested rules exercising the `&` parent selector and selector emission.
function NESTING() -> string {
    "\n"
        + ".card {\n"
        + "  color: #333;\n"
        + "  .header {\n"
        + "    font-weight: bold;\n"
        + "    &:hover { color: #0066cc; }\n"
        + "    .title { a { color: red; &:visited { color: purple; } } }\n"
        + "  }\n"
        + "  .body {\n"
        + "    p { margin: 0; line-height: 1.5; }\n"
        + "    .footer { small { opacity: 0.6; &::after { content: \"\"; } } }\n"
        + "  }\n"
        + "}\n"
}

/// Control-flow heavy input: `@for` / `@each` loops with interpolation.
function CONTROL_FLOW() -> string {
    "\n"
        + "@use \"sass:math\";\n"
        + "@for $i from 1 through 100 {\n"
        + "  .col-#{$i} { width: math.div($i, 100) * 100%; }\n"
        + "}\n"
        + "@each $name, $size in (sm: 4px, md: 8px, lg: 16px, xl: 32px) {\n"
        + "  .pad-#{$name} { padding: $size; }\n"
        + "  .gap-#{$name} { gap: $size; }\n"
        + "}\n"
}

/// Color-function heavy input: builds a shade scale from a base color.
function COLORS() -> string {
    "\n"
        + "@use \"sass:color\";\n"
        + "$base: #3498db;\n"
        + "@for $i from 1 through 40 {\n"
        + "  .shade-#{$i} {\n"
        + "    background: color.adjust($base, $lightness: $i * 1%);\n"
        + "    border-color: rgba($base, 0.5);\n"
        + "    box-shadow: 0 0 ($i * 1px) mix($base, white, 50%);\n"
        + "  }\n"
        + "}\n"
}

/// `Options` in the shape a real invocation has: a display URL, which is the
/// only thing that turns diagnostics on (`compile` sets the diagnostic source
/// only when `options.url` is `Some`, `src/lib.rs:560`), plus a handler that
/// throws the warnings away.
///
/// Every benchmark added for a lever in `docs/PERF_PLAN_2026-09-16.md` goes
/// through here, because the alternative is easy to write and measures half a
/// program: a corpus wired up with a bare `Options::default()` leaves
/// `diag_enabled()` false, and a deprecation-dense sheet then protects only the
/// construction half of the path it was added for.
///
/// The handler is a no-op on purpose. A benchmark has no business writing to
/// stderr, and staying quiet costs nothing measurable: printing measured
/// 9.478 ms against the silent 9.408 ms on `large_expanded_with_url_silent`,
/// i.e. the same within noise, so the surcharge is bookkeeping rather than I/O.
function diagnostics_live(url: string) -> root.Options {
    // `WarnHandler` is an `Rc`, which is not `Sync`, so divan cannot hoist it
    // out of a benched closure -- it has to be built inside. One `Rc::new` per
    // iteration is noise against a multi-millisecond compile.
    let sink: root.WarnHandler = (_ev: root.WarnEvent) -> void {};
    root.Options.default().with_url(url).with_warn_handler(sink)
}

/// The importer the `@use`-graph benchmarks pass, built fresh per compile as a
/// CLI invocation would: [`sasso::FsImporter`] carries the per-compilation
/// dependency record, so sharing one across iterations would accumulate state
/// no real run has.
function use_graph_importer() -> root.importer.FsImporter {
    root.importer.FsImporter.new([USE_GRAPH_VENDOR()])
}

/// Compile each gate corpus once, before divan takes over, and check the marker
/// rule is in the output.
///
/// A benchmark that silently stopped compiling what it claims to would still
/// report a number, and a faster one. `compile(...).unwrap()` catches an error,
/// but not the subtler failure this guards: three earlier `@use`-graph
/// measurements in `bench/perf_audit_2026-09-15.md` were void because the
/// vendor load path was missing, so they timed a *failed* compile. In the
/// `@use` graph the marker comes from a mixin defined in a loaded module, so it
/// can only appear if the graph actually resolved.
function corpora_still_compile() -> void {
    let named: root.std.Tuple2<string, string>[] = [
        root.std.Tuple2<string, string> {
            _0: "legacy_deprecations.scss",
            _1: LEGACY_DEPRECATIONS(),
        },
        root.std.Tuple2<string, string> { _0: "extend_heavy.scss", _1: EXTEND_HEAVY() },
        root.std.Tuple2<string, string> { _0: "selector_lists.scss", _1: SELECTOR_LISTS() },
    ];
    for (let pair in named) {
        let name = pair._0;
        let source = pair._1;
        let css = root.compile(source, diagnostics_live(name)) catch (e) {
            let e: root.error.Error => {
                root.std.panic(`bench corpus ${name} failed to compile: ${e.to_string()}`)
            }
        };
        root.std.assert_true(
            css.includes(GATE_MARKER()),
            `bench corpus ${name} lost its marker rule`,
        );
    }

    let graphs: root.std.Tuple2<string, string>[] = [
        root.std.Tuple2<string, string> { _0: USE_GRAPH_ENTRY_URL(), _1: USE_GRAPH_ENTRY() },
        root.std.Tuple2<string, string> { _0: USE_GRAPH_REDUNDANT_URL(), _1: USE_GRAPH_REDUNDANT() },
    ];
    for (let pair in graphs) {
        let url = pair._0;
        let source = pair._1;
        let importer = use_graph_importer();
        let opts = diagnostics_live(url).with_importer(importer);
        let css = root.compile(source, opts) catch (e) {
            let e: root.error.Error => {
                root.std.panic(`bench corpus ${url} failed to compile: ${e.to_string()}`)
            }
        };
        root.std.assert_true(
            css.includes(GATE_MARKER()),
            `bench corpus ${url} lost its marker rule`,
        );
    }
}

// PORT: `bencher.bench(|| … .unwrap())` — an `Err` from `compile` propagates
// out of the benched closure and aborts the run, as the `unwrap` panic would.

function large_expanded(bencher: Bencher) -> void {
    bencher.bench(() -> unknown throws unknown {
        root.compile(black_box(LARGE()), root.Options.default())
    });
}

/// `large_expanded` with diagnostics live: a display URL turns on the
/// deprecation bookkeeping that the URL-less benchmarks skip entirely.
///
/// Read this **against** `large_expanded`. The ratio of the two is the
/// diagnostics surcharge, and it is that ratio, not either number alone, that
/// would have flagged the two deprecation merges of 2026-09-15. Measured at
/// +15.7% (macOS/arm64) and +9.6% (Linux/x86_64) on 2026-09-16 against the
/// printing arm, and +12.5% fastest / +10.8% median here against the silent
/// one; treat the spread as the reason CI wants instruction counts rather than
/// wall time.
function large_expanded_with_url_silent(bencher: Bencher) -> void {
    bencher.bench(() -> unknown throws unknown {
        root.compile(black_box(LARGE()), diagnostics_live("large.scss"))
    });
}

/// A legacy-deprecation-dense sheet, with diagnostics live: the corpus for A1
/// in `docs/PERF_PLAN_2026-09-16.md`, and the suite's early-warning signal for
/// the whole diagnostics area.
///
/// Every one of the mixin's 13 call sites is a deprecated name, and 1200
/// `@include`s repeat those same 13 spans, so this measures the gates, the
/// dedup and the memo rather than how fast 15600 distinct warnings can be
/// built. A1 measured **-48.3%** here against **-17.4%** on `large.scss`
/// (macOS/arm64, 2026-09-16, `b1acfe6` vs `7346b5a`, byte-identical output), so
/// a regression in that path shows up here about three times as loudly.
function legacy_deprecations_with_url_silent(bencher: Bencher) -> void {
    bencher.bench(() -> unknown throws unknown {
        root.compile(black_box(LEGACY_DEPRECATIONS()), diagnostics_live("legacy_deprecations.scss"))
    });
}

/// An `@extend`-heavy sheet: the corpus for A2, which measures **0.00% on
/// `large.scss`** because `large.scss` contains no `@extend` at all.
///
/// Without this benchmark, landing A2 and then regressing it are
/// indistinguishable in CI. The A2 prototype measured **-49.7%** here with
/// byte-identical output, against -0.2% on `large.scss` (macOS/arm64,
/// 2026-09-16, `ad11c61` vs the salvaged prototype).
///
/// It is deliberately not the largest `@extend` shape that could be generated.
/// `@extend` grows super-linearly: the first shape tried -- five times the
/// extending selectors, every one of them extending from a nested context --
/// measured 442 ms/compile against this one's 7.6 ms. That is a bigger delta
/// bought with ~58x the runner time.
function extend_heavy_with_url_silent(bencher: Bencher) -> void {
    bencher.bench(() -> unknown throws unknown {
        root.compile(black_box(EXTEND_HEAVY()), diagnostics_live("extend_heavy.scss"))
    });
}

/// Multi-line comma selector lists, with the diagnostics live because the
/// dropped-selector warnings are part of the shape.
///
/// This is a coverage corpus before it is a lever: `share_current == false` is
/// the branch a hand-written sheet takes and no other corpus reaches, so work
/// added there — the span mapping behind `bogus-combinators`, for one — could
/// not be measured at all. A corpus that makes a regression visible is worth
/// having even when nothing here is trying to make it faster.
function selector_lists_with_url_silent(bencher: Bencher) -> void {
    bencher.bench(() -> unknown throws unknown {
        root.compile(black_box(SELECTOR_LISTS()), diagnostics_live("selector_lists.scss"))
    });
}

/// A multi-file `@use` graph, 43 files behind one entry: the corpus for A3,
/// which measures **0.00% single-file**.
///
/// Unlike the other benchmarks this one touches the filesystem, because the
/// thing being measured is import resolution. The importer is built per
/// iteration, as a CLI invocation would build it. The A3 prototype measured
/// **-39.5%** here (macOS/arm64, 2026-09-16, `ad11c61` vs the salvaged
/// prototype), with byte-identical output.
function use_graph_with_url_silent(bencher: Bencher) -> void {
    bencher.bench(() -> unknown throws unknown {
        let importer = use_graph_importer();
        let opts = diagnostics_live(USE_GRAPH_ENTRY_URL()).with_importer(importer);
        root.compile(black_box(USE_GRAPH_ENTRY()), opts)
    });
}

/// The same graph reached twice over -- the entry loads every section *and*
/// every component and token file directly -- so ~40 modules arrive at the
/// importer already in the module cache.
///
/// This is the redundant-`@use` case B4 asks for, and it is the shape that
/// separates "probe the cache before calling the importer" from "resolve
/// everything twice": the CSS is byte-identical to `use_graph_with_url_silent`
/// (`@use` is idempotent) while the base cost is ~30% higher. The A3 prototype
/// measured **-42.2%** here.
function use_graph_redundant_with_url_silent(bencher: Bencher) -> void {
    bencher.bench(() -> unknown throws unknown {
        let importer = use_graph_importer();
        let opts = diagnostics_live(USE_GRAPH_REDUNDANT_URL()).with_importer(importer);
        root.compile(black_box(USE_GRAPH_REDUNDANT()), opts)
    });
}

/// `large_expanded_with_url_silent` with a source map generated alongside the
/// CSS: the corpus for the source-map row of `docs/PERF_PLAN_2026-09-16.md`
/// (A5), which no other benchmark here touches at all.
///
/// Read this **against** `large_expanded_with_url_silent`, exactly as that one
/// is read against `large_expanded`: the ratio is the map surcharge, measured at
/// +25% (CLI) to +37% (in-process) on 2026-09-16. Only the difference is
/// meaningful — the map path is the only thing the two benchmarks disagree
/// about, and the map's JSON is deliberately *not* serialized here, because
/// `SourceMap::to_json` is string escaping rather than mapping arithmetic.
///
/// The CLI cannot stand in for this. `--loop` refuses to run with
/// `--source-map` (`src/main.rs`), so before this benchmark existed the map path
/// could only be measured one process at a time, with process startup inside
/// every reading.
function large_expanded_with_map_silent(bencher: Bencher) -> void {
    bencher.bench(() -> unknown throws unknown {
        root.compile_with_source_map(black_box(LARGE()), diagnostics_live("large.scss"))
    });
}

function large_compressed(bencher: Bencher) -> void {
    bencher.bench(() -> unknown throws unknown {
        let opts = root.Options.default();
        opts.style = root.OutputStyle.Compressed;
        root.compile(black_box(LARGE()), opts)
    });
}

function nesting(bencher: Bencher) -> void {
    bencher.bench(() -> unknown throws unknown {
        root.compile(black_box(NESTING()), root.Options.default())
    });
}

function control_flow(bencher: Bencher) -> void {
    bencher.bench(() -> unknown throws unknown {
        root.compile(black_box(CONTROL_FLOW()), root.Options.default())
    });
}

function colors(bencher: Bencher) -> void {
    bencher.bench(() -> unknown throws unknown {
        root.compile(black_box(COLORS()), root.Options.default())
    });
}

// ---------------------------------------------------------------------------
// PORT: everything below stands in for the `divan` harness and for the
// compile-time macros (`include_str!`, `env!`) the Rust file leans on. It has
// no counterpart line in `benches/compile.rs`.
// ---------------------------------------------------------------------------

/// PORT: a `#[divan::bench]` function.
type BenchFn = (Bencher) -> void throws unknown;

/// PORT: `#[divan::bench]` registration — every benchmark above, by name.
function BENCHES() -> root.std.Tuple2<string, BenchFn>[] {
    [
        root.std.Tuple2<string, BenchFn> { _0: "large_expanded", _1: large_expanded },
        root.std.Tuple2<string, BenchFn> {
            _0: "large_expanded_with_url_silent",
            _1: large_expanded_with_url_silent,
        },
        root.std.Tuple2<string, BenchFn> {
            _0: "legacy_deprecations_with_url_silent",
            _1: legacy_deprecations_with_url_silent,
        },
        root.std.Tuple2<string, BenchFn> {
            _0: "extend_heavy_with_url_silent",
            _1: extend_heavy_with_url_silent,
        },
        root.std.Tuple2<string, BenchFn> {
            _0: "selector_lists_with_url_silent",
            _1: selector_lists_with_url_silent,
        },
        root.std.Tuple2<string, BenchFn> {
            _0: "use_graph_with_url_silent",
            _1: use_graph_with_url_silent,
        },
        root.std.Tuple2<string, BenchFn> {
            _0: "use_graph_redundant_with_url_silent",
            _1: use_graph_redundant_with_url_silent,
        },
        root.std.Tuple2<string, BenchFn> {
            _0: "large_expanded_with_map_silent",
            _1: large_expanded_with_map_silent,
        },
        root.std.Tuple2<string, BenchFn> { _0: "large_compressed", _1: large_compressed },
        root.std.Tuple2<string, BenchFn> { _0: "nesting", _1: nesting },
        root.std.Tuple2<string, BenchFn> { _0: "control_flow", _1: control_flow },
        root.std.Tuple2<string, BenchFn> { _0: "colors", _1: colors },
    ]
}

/// PORT: `env!("CARGO_MANIFEST_DIR")` → `root.tests.support.manifest_dir()`.
/// That runs `pwd`, so it is looked up once per process and memoized; the
/// Rust value is a compile-time constant and costs the benched closures
/// nothing.
client MANIFEST_DIR_CELL = root.std.Cell<string?> { value: null };

function CARGO_MANIFEST_DIR() -> string {
    let cached = MANIFEST_DIR_CELL.get();
    if (cached != null) {
        return cached;
    }
    let dir = root.tests.support.manifest_dir();
    MANIFEST_DIR_CELL.set(dir);
    dir
}

/// PORT: `include_str!(path)` embeds the file at compile time; here it is read
/// (relative to `benches/`, as `include_str!` resolves it) once per process
/// and memoized, so the benched closures pay nothing for it either.
client INCLUDE_STR_CELL = root.std.Cell<map<string, string>> { value: {} };

function include_str(rel: string) -> string {
    let cache = INCLUDE_STR_CELL.get();
    let hit = cache.get(rel);
    if (hit != null) {
        return hit;
    }
    let path = CARGO_MANIFEST_DIR() + "/benches/" + rel;
    let text = root.std.read_to_string(path) catch (e) {
        let e: baml.errors.Io => root.std.panic(`couldn't read ${path}: ${e.message}`)
    };
    cache.set(rel, text);
    text
}

/// PORT: `divan::black_box` — the BAML VM does not optimize a result away, so
/// this is the identity.
function black_box<T>(x: T) -> T {
    x
}

/// PORT: `divan::Bencher` — a minimal single-threaded wall-clock stand-in.
///
/// As divan's own loop: one tuning sample is run and discarded, then samples
/// are collected until `sample_count` of them are taken or `max_time_ns` has
/// elapsed (at least one is always taken). divan grows the sample size until a
/// sample lasts 100x the timer's precision; a BAML compile takes milliseconds
/// against a nanosecond clock, so the sample size is always 1 (`iters ==
/// samples`).
class Bencher {
    sample_count: int,
    max_time_ns: int,
    /// Collected sample durations, in nanoseconds.
    samples: int[],

    function bench(self, benched: () -> unknown throws unknown) -> void {
        if (self.max_time_ns == 0 || self.sample_count == 0) {
            return;
        }
        // Tuning sample (divan's `BenchMode::Tune`), discarded.
        let _ = black_box(benched());
        let initial_start = root.std.now_nanos();
        let elapsed = 0;
        let rem_samples = self.sample_count;
        while (elapsed < self.max_time_ns && rem_samples > 0) {
            let start = root.std.now_nanos();
            let out = benched();
            let end = root.std.now_nanos();
            // divan drops outputs outside the timed region.
            let _ = black_box(out);
            self.samples.push(root.std.int_of(end - start));
            rem_samples -= 1;
            elapsed = root.std.int_of(root.std.now_nanos() - initial_start);
        }
    }
}

/// divan's statistics over one benchmark's samples.
class Stats {
    fastest: int,
    slowest: int,
    median: int,
    mean: int,
    samples: int,
    iters: int,
}

function stats_of(samples: int[]) -> Stats {
    let sorted = samples.slice(0, samples.length()).sort_by_key((s: int) -> int {
        s
    });
    let n = sorted.length();
    let total = sorted.reduce(
        (a: int, s: int) -> int {
            a + s
        },
        0,
    );
    let median = if (n % 2 == 1) {
        sorted[n / 2]
    } else {
        (sorted[n / 2 - 1] + sorted[n / 2]) / 2
    };
    Stats {
        fastest: sorted[0],
        slowest: sorted[n - 1],
        median: median,
        mean: total / n,
        samples: n,
        iters: n,
    }
}

/// divan's `FineDuration` display: 4 significant figures and a unit suffix.
function fmt_duration(ns: int) -> string {
    let scale = if (ns < 1000) {
        root.std.Tuple2<int, string> { _0: 1, _1: "ns" }
    } else if (ns < 1000000) {
        root.std.Tuple2<int, string> { _0: 1000, _1: "µs" }
    } else if (ns < 1000000000) {
        root.std.Tuple2<int, string> { _0: 1000000, _1: "ms" }
    } else {
        root.std.Tuple2<int, string> { _0: 1000000000, _1: "s" }
    };
    // Multiply to allow 4 digits of fractional precision.
    let val = root.std.int_to_f64(ns * 10000 / scale._0) / 10000.0;
    `${fmt_sig_figs(val, 4)} ${scale._1}`
}

/// divan's `util::fmt::format_f64`: `val.to_string()` cut to `sig_figs`
/// significant figures, trailing fractional zeros dropped.
function fmt_sig_figs(val: float, sig_figs: int) -> string {
    let s = root.std.fmt_f64(val);
    let dot = s.index_of(".");
    if (dot == null) {
        return s;
    }
    let dot_index: int = dot;
    let fract_digits = root.std.saturating_sub_u(sig_figs, dot_index);
    if (fract_digits == 0) {
        return s.slice(0, dot_index);
    }
    let fract_start = dot_index + 1;
    let fract_end = root.std.imin(fract_start + fract_digits, s.length());
    let fract = s.slice(fract_start, fract_end);
    // Drop trailing zeros (and the dot, when nothing else is left).
    let keep = fract.length();
    while (keep > 0 && fract.slice(keep - 1, keep) == "0") {
        keep -= 1;
    }
    if (keep == 0) {
        s.slice(0, dot_index)
    } else {
        s.slice(0, fract_start + keep)
    }
}

function pad_right(s: string, width: int) -> string {
    let out = s;
    while (out.length() < width) {
        out = out + " ";
    }
    out
}

/// A divan-style row: the tree-drawn name, then the time columns.
function fmt_row(name: string, name_width: int, cols: string[]) -> string {
    let out = pad_right(name, name_width);
    let i = 0;
    while (i < cols.length()) {
        // Time columns are 13 wide, the counts 7; the last is not padded.
        let width = if (i == cols.length() - 1) {
            0
        } else if (i < 4) {
            13
        } else {
            7
        };
        let sep = if (i == 0) {
            "  "
        } else {
            " │ "
        };
        out = out + sep + pad_right(cols[i], width);
        i += 1;
    }
    out
}

/// PORT: `divan::main()` — run every registered benchmark (sorted by name, as
/// divan does) whose name matches a positional filter (all when there is
/// none), printing each row as it finishes.
function divan_main() -> void {
    let sample_count = baml.Int.parse(root.std.env_var("DIVAN_SAMPLE_COUNT") ?? "100") catch (e) {
        _ => 100
    };
    let max_time_s = baml.Float.parse(root.std.env_var("DIVAN_MAX_TIME") ?? "10") catch (e) {
        _ => 10.0
    };
    let max_time_ns = root.std.f64_to_int(max_time_s * 1000000000.0);
    let filters = root.std.args().slice(1, root.std.args().length());

    let benches = BENCHES().filter((b) -> bool {
        filters.length() == 0
            || filters.some((f: string) -> bool {
                b._0.includes(f)
            })
    });
    benches.sort_by_key((b) -> string {
        b._0
    });

    let name_width = 0;
    for (let b in benches) {
        name_width = root.std.imax(name_width, b._0.length() + 3);
    }
    name_width = root.std.imax(name_width, "compile".length());
    baml.io.println(
        fmt_row("compile", name_width, ["fastest", "slowest", "median", "mean", "samples", "iters"]),
    );
    let i = 0;
    while (i < benches.length()) {
        let b = benches[i];
        let bencher = Bencher { sample_count: sample_count, max_time_ns: max_time_ns, samples: [] };
        b._1(bencher);
        let prefix = if (i == benches.length() - 1) {
            "╰─ "
        } else {
            "├─ "
        };
        if (bencher.samples.length() == 0) {
            baml.io.println(prefix + b._0);
        } else {
            let st = stats_of(bencher.samples);
            baml.io.println(
                fmt_row(
                    prefix + b._0,
                    name_width,
                    [
                        fmt_duration(st.fastest),
                        fmt_duration(st.slowest),
                        fmt_duration(st.median),
                        fmt_duration(st.mean),
                        st.samples.to_string(),
                        st.iters.to_string(),
                    ],
                ),
            );
        }
        i += 1;
    }
}
