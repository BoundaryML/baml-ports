testset "unicode_width" {
    test "ascii" {
        assert.equal(str_width("hello"), 5);
        assert.equal(char_width("a"), 1);
        assert.equal(char_width("\n"), null)
    }
    test "cafe" { assert.equal(str_width("Café Plain"), 10) }
    test "narrow_emojis" { assert.equal(str_width("⁉"), 1) }
    test "emojis" { assert.equal(str_width("😂😭🥺🤣✨😍🙏🥰😊🔥"), 20) }
    test "cjk" { assert.equal(str_width("你好"), 4) }
    test "combining" { assert.equal(str_width(baml.String.from_code_points([101, 769])), 1) }
}
