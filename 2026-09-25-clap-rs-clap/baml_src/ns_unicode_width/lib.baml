// Port of unicode-width-0.2 (src/lib.rs + src/tables.rs)
//
// Determine displayed width of `char` and `str` types according to Unicode
// Standard Annex #11 rules. `clap_builder` uses
// `UnicodeWidthChar::width(ch).unwrap_or(0)` (feature `unicode`) to measure
// help text.
//
// The generated Rust tables are replaced here by flattened `[lo, hi, lo, hi, ...]`
// range tables of zero-width (combining / format) and wide (East Asian Wide
// and Fullwidth, plus emoji presentation) code points.

/// `UnicodeWidthChar::width`: returns the character's displayed width in
/// columns, or `null` if it is a control character other than `\x00`.
function char_width(c: string) -> int? {
    let cp = c.code_point_at(0) ?? 0;
    code_point_width(cp)
}

function code_point_width(cp: int) -> int? {
    if (cp == 0) {
        return 0;
    }
    if (cp < 0x20 || (cp >= 0x7f && cp < 0xa0)) {
        return null;
    }
    if (cp < 0x300) {
        return 1;
    }
    if (in_table(zero_width_table(), cp)) {
        return 0;
    }
    if (in_table(wide_table(), cp)) {
        return 2;
    }
    1
}

/// `UnicodeWidthChar::width_cjk`: like `char_width` but East Asian Ambiguous
/// characters are treated as wide. (Ambiguous ranges are not tabulated here,
/// so this matches `char_width`.)
function char_width_cjk(c: string) -> int? {
    char_width(c)
}

/// `UnicodeWidthStr::width`: returns the string's displayed width in columns.
///
/// Control characters are treated as having zero width.
function str_width(s: string) -> int {
    s.to_code_points().reduce((acc, cp) -> { acc + (code_point_width(cp) ?? 0) }, 0)
}

/// Binary search a flattened `[lo, hi, ...]` range table
function in_table(table: int[], cp: int) -> bool {
    let lo = 0;
    let hi = table.length() / 2 - 1;
    while (lo <= hi) {
        let mid = (lo + hi) / 2;
        let start = table[mid * 2];
        let end = table[mid * 2 + 1];
        if (cp < start) {
            hi = mid - 1;
        } else if (cp > end) {
            lo = mid + 1;
        } else {
            return true;
        }
    }
    false
}

